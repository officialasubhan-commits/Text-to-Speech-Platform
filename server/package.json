{
  "name": "tts-server",
  "version": "1.0.0",
  "description": "Text-to-Speech Web Application — Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:generate": "npx prisma generate",
    "test": "jest --runInBand"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.2",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^14.0.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "protobufjs@7.6.6": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  }
}
